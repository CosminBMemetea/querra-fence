<?xml version="1.0"?>
<package format="3">
  <name>querra_fence_ros</name>
  <version>0.1.0</version>
  <description>QUERRA Fence on ROS 2: cameras from the panel hub, GPS from gpsd, LD2450 radar from the ld2450-radar service.</description>
  <maintainer email="CosminBMemetea@users.noreply.github.com">Cosmin B. Memetea</maintainer>
  <license>MIT</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>vision_msgs</exec_depend>
  <exec_depend>python3-pil</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <exec_depend>querra_fence_msgs</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
