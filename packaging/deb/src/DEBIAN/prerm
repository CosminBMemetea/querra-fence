#!/bin/sh
set -e
U=mmx
gs() { runuser -u "$U" -- env DBUS_SESSION_BUS_ADDRESS="unix:path=$BUS" gsettings "$@"; }
if [ "$1" = remove ] && id "$U" >/dev/null 2>&1 && command -v gsettings >/dev/null; then
  BUS=/run/user/$(id -u "$U")/bus
  if [ -S "$BUS" ]; then
    CUR=$(gs get org.gnome.shell favorite-apps 2>/dev/null || true)
    case "$CUR" in *querra-fence.desktop*)
      NEW=$(printf '%s' "$CUR" | sed "s/, 'querra-fence.desktop'//; s/'querra-fence.desktop', //; s/'querra-fence.desktop'//")
      gs set org.gnome.shell favorite-apps "$NEW" || true ;;
    esac
  fi
fi
exit 0
