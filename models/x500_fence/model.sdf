<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="x500_fence">
    <self_collide>false</self_collide>
    <include merge="true">
      <uri>model://x500</uri>
    </include>
    <!-- Inspection camera: 640x400 at 15 fps (lighter than the PX4 1280x960@30 camera, keeps the simulation smooth on an M2) -->
    <link name="fence_cam_link">
      <pose relative_to="base_link">0.13 0 -0.06 0 0.96 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia><ixx>0.00004</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.00004</iyy><iyz>0</iyz><izz>0.00004</izz></inertia>
      </inertial>
      <visual name="fence_cam_body">
        <geometry><box><size>0.04 0.05 0.05</size></box></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <visual name="fence_cam_lens">
        <pose>0.025 0 0 0 1.5707 0</pose>
        <geometry><cylinder><radius>0.014</radius><length>0.012</length></cylinder></geometry>
        <material><ambient>0.2 0.25 0.35 1</ambient><diffuse>0.2 0.25 0.35 1</diffuse><specular>0.9 0.9 0.9 1</specular></material>
      </visual>
      <sensor name="fence_cam" type="camera">
        <camera>
          <horizontal_fov>1.204</horizontal_fov>
          <image><width>640</width><height>400</height></image>
          <clip><near>0.2</near><far>400</far></clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>15</update_rate>
        <visualize>false</visualize>
        <topic>/fence_cam/image</topic>
      </sensor>
    </link>
    <joint name="fence_cam_joint" type="fixed">
      <parent>base_link</parent>
      <child>fence_cam_link</child>
    </joint>
  </model>
</sdf>
