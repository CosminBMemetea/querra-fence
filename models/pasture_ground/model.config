<?xml version="1.0"?>
<model>
  <name>pasture_ground</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author><name>Cosmin B. Memetea</name></author>
  <description>
    Ground for the "rich" pasture look: a terrain mesh (meshes/ground.obj, generated by sim/gen_world.py from
    fence.json: flat paddock, hills further out) and seamless grass textures (materials/textures, generated by
    tools/make_textures.py). The world references the mesh and textures directly; model.sdf is a standalone preview.
  </description>
</model>
