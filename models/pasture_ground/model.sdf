<?xml version="1.0"?>
<sdf version="1.9">
  <model name="pasture_ground">
    <static>true</static>
    <link name="link">
      <visual name="visual">
        <geometry><mesh><uri>model://pasture_ground/meshes/ground.obj</uri></mesh></geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <pbr><metal>
            <albedo_map>model://pasture_ground/materials/textures/grass_albedo.png</albedo_map>
            <normal_map>model://pasture_ground/materials/textures/grass_normal.png</normal_map>
            <roughness>0.95</roughness><metalness>0.0</metalness>
          </metal></pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
